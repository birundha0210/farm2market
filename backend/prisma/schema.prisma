generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  FARMER
  BUYER
  ADMIN
}
enum ProductStatus {
  ACTIVE
  SOLD_OUT
  INACTIVE
}
enum OrderStatus {
  PENDING
  FARMER_ACCEPTED
  REJECTED
  BUYER_REJECTED
  CONFIRMED
}
enum BusinessType {
  SUPER_MARKET
  MINI_MARKET
  VEGETABLE_SHOP
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  username String @unique
  passwordHash String
  loginCode String @unique
  dob DateTime
  gender String
  role Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farmerProfile FarmerProfile?
  buyerProfile BuyerProfile?
  products Product[] @relation("FarmerProducts")
  buyerOrders Order[] @relation("BuyerOrders")
  farmerOrders Order[] @relation("FarmerOrders")
  notifications Notification[]
}
model FarmerProfile {
  id String @id @default(cuid())
  userId String @unique
  landDetails String
  landAcres Decimal @db.Decimal(10,2)
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model BuyerProfile {
  id String @id @default(cuid())
  userId String @unique
  shopNumber String
  businessType BusinessType
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Category {
  id String @id @default(cuid())
  name String @unique
  description String?
  products Product[]
}
model Product {
  id String @id @default(cuid())
  farmerId String
  categoryId String
  name String
  imageUrl String?
  quantityKg Int
  pricePerKg Decimal @db.Decimal(12,2)
  status ProductStatus @default(ACTIVE)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farmer User @relation("FarmerProducts", fields: [farmerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  orders Order[]
  @@index([status, categoryId])
}
model Order {
  id String @id @default(cuid())
  buyerId String
  farmerId String
  productId String
  requestedQuantityKg Int
  agreedPricePerKg Decimal @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(14,2)
  farmerAccepted Boolean @default(false)
  buyerAccepted Boolean @default(false)
  status OrderStatus @default(PENDING)
  buyerLatitude Decimal? @db.Decimal(10,7)
  buyerLongitude Decimal? @db.Decimal(10,7)
  farmerLatitude Decimal? @db.Decimal(10,7)
  farmerLongitude Decimal? @db.Decimal(10,7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmer User @relation("FarmerOrders", fields: [farmerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([buyerId, status])
  @@index([farmerId, status])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}
